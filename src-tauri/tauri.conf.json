{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vinyl",
  "version": "0.1.0",
  "identifier": "com.vinyl.hud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Vinyl",
      "width": 560,
      "height": 330,
      "minWidth": 420,
      "minHeight": 280,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "center": true,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}